doctype html
html(lang="fr" data-theme="dark")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover")
    meta(name="theme-color" content="#0b1020")
    meta(name="mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-title" content="LDDM List")
    link(rel="manifest" href="/manifest.json")
    link(rel="icon" href="/assets/icons/icon192.png")
    link(rel="apple-touch-icon" href="/assets/icons/icon192.png")
    title LDDM List
    script.
      try {
        var t = localStorage.getItem('lddm_theme');
        if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    link(rel="stylesheet" href="/assets/css/app.css")

  body(data-tab="tasks")

    //- ── Icônes (sprite SVG) ──
    svg(xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute" aria-hidden="true")
      symbol#i-plus(viewBox="0 0 24 24"): path(d="M5 12h14M12 5v14")
      symbol#i-edit(viewBox="0 0 24 24")
        path(d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z")
        path(d="m15 5 4 4")
      symbol#i-trash(viewBox="0 0 24 24")
        path(d="M3 6h18")
        path(d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6")
        path(d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2")
      symbol#i-check(viewBox="0 0 24 24"): path(d="M20 6 9 17l-5-5")
      symbol#i-bell(viewBox="0 0 24 24")
        path(d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9")
        path(d="M10.3 21a1.94 1.94 0 0 0 3.4 0")
      symbol#i-sun(viewBox="0 0 24 24")
        circle(cx="12" cy="12" r="4")
        path(d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41")
      symbol#i-moon(viewBox="0 0 24 24"): path(d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z")
      symbol#i-search(viewBox="0 0 24 24")
        circle(cx="11" cy="11" r="8")
        path(d="m21 21-4.3-4.3")
      symbol#i-tasks(viewBox="0 0 24 24")
        path(d="m9 11 3 3L22 4")
        path(d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11")
      symbol#i-cart(viewBox="0 0 24 24")
        circle(cx="8" cy="21" r="1")
        circle(cx="19" cy="21" r="1")
        path(d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12")
      symbol#i-clock(viewBox="0 0 24 24")
        circle(cx="12" cy="12" r="10")
        path(d="M12 6v6l4 2")
      symbol#i-x(viewBox="0 0 24 24"): path(d="M18 6 6 18M6 6l12 12")
      symbol#i-inbox(viewBox="0 0 24 24")
        path(d="M22 12h-6l-2 3h-4l-2-3H2")
        path(d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11Z")

    //- ── Barre du haut ──
    header.topbar
      .brand
        .logo: svg.icon: use(href="#i-tasks")
        .brand-text
          h1 LDDM List
          p#today.muted
      .topbar-actions
        button#btn-notif.btn.soft(type="button" hidden)
          svg.icon: use(href="#i-bell")
          span.hide-sm Notifications
        button#btn-theme.icon-btn(type="button" aria-label="Changer de thème" title="Changer de thème")
          svg.icon.theme-dark: use(href="#i-sun")
          svg.icon.theme-light: use(href="#i-moon")
        button#btn-user.user-chip(type="button" title="Changer d'utilisateur")
          span#user-avatar.avatar ?
          span#user-name Qui es-tu ?

    main.layout

      //- ── Tâches ──
      section#panel-tasks.panel(aria-labelledby="h-tasks")
        .panel-head
          div
            h2#h-tasks Tâches
            p#task-stats.muted
          button#btn-add-task.btn.primary(type="button")
            svg.icon: use(href="#i-plus")
            span Nouvelle tâche

        .toolbar
          label.search
            svg.icon: use(href="#i-search")
            input#search(type="search" placeholder="Rechercher une tâche…" autocomplete="off" aria-label="Rechercher")
          .chips#filter-status(role="group" aria-label="Statut")
            button.chip(type="button" data-value="todo" aria-pressed="true") À faire
            button.chip(type="button" data-value="done" aria-pressed="false") Terminées
            button.chip(type="button" data-value="all" aria-pressed="false") Toutes
          .chips#filter-who(role="group" aria-label="Personne")
            button.chip(type="button" data-value="all" aria-pressed="true") Tous
            button.chip(type="button" data-value="Lola" aria-pressed="false") Lola
            button.chip(type="button" data-value="David" aria-pressed="false") David
            button.chip(type="button" data-value="Les 2" aria-pressed="false") Les 2
          .selects
            select#filter-priority(aria-label="Priorité")
              option(value="all") Toutes priorités
              option(value="haute") Haute
              option(value="moyenne") Moyenne
              option(value="faible") Faible
            select#sort(aria-label="Tri")
              option(value="asc") Date ↑ (proches d'abord)
              option(value="desc") Date ↓ (récentes d'abord)

        #task-list.list

      //- ── Courses ──
      section#panel-courses.panel(aria-labelledby="h-courses")
        .panel-head
          div
            h2#h-courses Courses
            p#course-stats.muted
        form#course-form.inline-form(autocomplete="off")
          input#course-input(type="text" placeholder="Ajouter un article…" maxlength="200" required aria-label="Nouvel article")
          button.btn.primary(type="submit" aria-label="Ajouter")
            svg.icon: use(href="#i-plus")
            span.hide-sm Ajouter
        #course-list.list
        button#btn-clear-checked.btn.ghost.full(type="button" hidden)
          svg.icon: use(href="#i-trash")
          span Retirer les articles cochés

    //- ── Navigation mobile / tablette portrait ──
    nav.bottom-nav(aria-label="Sections")
      button#nav-tasks(type="button" data-tab="tasks" aria-current="page")
        svg.icon: use(href="#i-tasks")
        span Tâches
        em#nav-tasks-count(hidden)
      button#nav-courses(type="button" data-tab="courses")
        svg.icon: use(href="#i-cart")
        span Courses
        em#nav-courses-count(hidden)

    button#fab.fab(type="button" aria-label="Nouvelle tâche")
      svg.icon: use(href="#i-plus")

    //- ── Fenêtre : ajouter / modifier une tâche ──
    dialog#task-dialog
      form#task-form.dialog-card(autocomplete="off" novalidate)
        .dialog-head
          h3#task-dialog-title Nouvelle tâche
          button.icon-btn(type="button" data-close aria-label="Fermer"): svg.icon: use(href="#i-x")
        .field
          label(for="f-name") Titre
          input#f-name(type="text" maxlength="200" required placeholder="Ex. : Rendez-vous dentiste")
        .field
          label(for="f-date") Date et heure
          input#f-date(type="datetime-local")
        .field
          label(for="f-desc") Description
          textarea#f-desc(rows="3" maxlength="2000" placeholder="Détails, commentaire…")
        .field
          span.label Priorité
          .segmented#f-priority(role="radiogroup")
            label.seg
              input(type="radio" name="priority" value="" checked)
              span Aucune
            label.seg.seg-haute
              input(type="radio" name="priority" value="haute")
              span Haute
            label.seg.seg-moyenne
              input(type="radio" name="priority" value="moyenne")
              span Moyenne
            label.seg.seg-faible
              input(type="radio" name="priority" value="faible")
              span Faible
        .field
          span.label Pour qui ?
          .segmented#f-qui(role="radiogroup")
            label.seg
              input(type="radio" name="qui" value="" checked)
              span Personne
            label.seg
              input(type="radio" name="qui" value="Lola")
              span Lola
            label.seg
              input(type="radio" name="qui" value="David")
              span David
            label.seg
              input(type="radio" name="qui" value="Les 2")
              span Les 2
        p#form-error.form-error(hidden)
        .dialog-actions
          button.btn.ghost(type="button" data-close) Annuler
          button#task-submit.btn.primary(type="submit") Enregistrer

    //- ── Fenêtre : confirmation ──
    dialog#confirm-dialog.small
      .dialog-card
        h3#confirm-title Confirmer
        p#confirm-text.muted
        .dialog-actions
          button.btn.ghost(type="button" data-close) Annuler
          button#confirm-ok.btn.danger(type="button") Supprimer

    //- ── Fenêtre : choix de l'utilisateur ──
    dialog#user-dialog.small
      .dialog-card
        h3 Qui utilise cet appareil ?
        p.muted Ton prénom sert à t'éviter les notifications de tes propres actions.
        .user-choices
          button.user-choice(type="button" data-user="Lola")
            span.avatar.a1 L
            | Lola
          button.user-choice(type="button" data-user="David")
            span.avatar.a2 D
            | David
          button.user-choice(type="button" data-user="Les 2")
            span.avatar.a3 2
            | Les 2

    #toasts(aria-live="polite")

    script#initial-data(type="application/json")!= initialData
    script(src="/js/app.js")
